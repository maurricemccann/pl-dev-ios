<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSCameraUsageDescription</key>
	<string>Take a photo to capture into the intake.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Turns your spoken note into text on this phone. Nothing is recorded or kept.</string>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>pldev</string>
			</array>
		</dict>
	</array>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Config file</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.json</string>
			</array>
		</dict>
	</array>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>processing</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.psychedluxuries.dev.refresh</string>
		<string>com.psychedluxuries.dev.process</string>
	</array>
	<key>NSUserActivityTypes</key>
	<array>
		<string>com.psychedluxuries.dev.open</string>
	</array>
	<key>NSHealthUpdateUsageDescription</key>
	<string>PL DEV writes a mindful session to Health after each rehearsal, only if you turn it on in Settings.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>PL DEV only writes mindful minutes. It reads nothing from Health.</string>
	<key>NSCalendarsWriteOnlyAccessUsageDescription</key>
	<string>PL DEV adds your shift days and drop dates to your calendar, only when you ask in Settings.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSMicrophoneUsageDescription</key>
	<string>PL DEV records your own voice for your affirmations, only when you tap the microphone.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>PL DEV reads the pictures and clips you choose from Photos, so Composer can put them in a shot. It copies only what you pick.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>PL DEV asks for Face ID when it opens, because it holds your keys.</string>
	<key>UIAppFonts</key>
	<array>
		<string>MaurriceMccannPsychedHandwrit-Regular.ttf</string>
		<string>PL-Hand-V2.ttf</string>
		<string>PL-Ransom-V2.ttf</string>
		<string>PLLedger-Regular.ttf</string>
		<string>courier-prime.ttf</string>
		<string>Jost-400-Book.ttf</string>
		<string>Jost-500-Medium.ttf</string>
		<string>Jost-600-Semi.ttf</string>
		<string>Jost-700-Bold.ttf</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
</dict>
</plist>
